{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "Spring Boot User Management API",
    "description": "Postman collection for springboot-user-management-api REST API.\nBase URL: http://localhost:8080/api",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "userId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"+919999888877\",\n  \"dateOfBirth\": \"1990-05-20\",\n  \"active\": true\n}"
            },
            "url": "{{baseUrl}}/users",
            "description": "Creates a new user. Returns 201 Created."
          }
        },
        {
          "name": "Get All Users (Paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/users?page=0&size=10&sortBy=id&direction=asc",
              "host": ["{{baseUrl}}"],
              "path": ["users"],
              "query": [
                { "key": "page", "value": "0", "description": "Zero-based page index" },
                { "key": "size", "value": "10", "description": "Page size (max 100)" },
                { "key": "sortBy", "value": "id", "description": "id|firstName|lastName|email|createdAt|updatedAt" },
                { "key": "direction", "value": "asc", "description": "asc or desc" }
              ]
            },
            "description": "Lists users with pagination and sorting."
          }
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/users/{{userId}}",
            "description": "Fetches a single user by primary key."
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Updated\",\n  \"phone\": \"9876543210\",\n  \"active\": true\n}"
            },
            "url": "{{baseUrl}}/users/{{userId}}",
            "description": "Partial or full update. Only sent fields are updated."
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/{{userId}}",
            "description": "Deletes user by id. Returns 200 on success."
          }
        }
      ]
    },
    {
      "name": "Examples - Validation Error",
      "item": [
        {
          "name": "Create User - Invalid Payload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"\",\n  \"email\": \"not-an-email\"\n}"
            },
            "url": "{{baseUrl}}/users",
            "description": "Demonstrates 400 validation error response."
          }
        }
      ]
    }
  ]
}
